    "FrontendCupView": {
      "description": "A cup competition's rounds \u2014 no fixtures, just resolved date windows.\n\nPairings within a cup round are drawn round by round and unknown ahead\nof time, unlike a league's `FrontendCompetitionView`, so there is no\n`matches` list here \u2014 see CONTRACT.md.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "is_cup": {
          "const": true,
          "default": true,
          "title": "Is Cup",
          "type": "boolean"
        },
        "match_count": {
          "title": "Match Count",
          "type": "integer"
        },
        "rounds": {
          "items": {
            "$ref": "#/$defs/FrontendCupRound"
          },
          "title": "Rounds",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "match_count",
        "rounds"
      ],
      "title": "FrontendCupView",
      "type": "object"
    },
