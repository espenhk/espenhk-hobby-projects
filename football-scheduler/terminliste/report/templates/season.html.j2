<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root {
    --bg: #f7f7f5;
    --panel: #ffffff;
    --ink: #1c1c1a;
    --muted: #6b6b66;
    --line: #e0e0da;
    --good: #1e8449;
    --bad: #c0392b;
    --warn: #b9770e;
    --accent: #2471a3;
  }
  * { box-sizing: border-box; }
  html, body { overflow-x: hidden; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 32px 20px 80px; }
  header h1 { margin: 0 0 4px; font-size: 26px; letter-spacing: -0.01em; }
  header .sub { color: var(--muted); font-size: 14px; }
  .notes {
    margin: 16px 0 0; padding: 12px 14px; border-left: 3px solid var(--bad);
    background: #fdf0ee; font-size: 14px;
  }
  .warnings {
    margin: 16px 0 0; padding: 12px 14px; border-left: 3px solid var(--warn);
    background: #fdf6ea; font-size: 14px;
  }
  .warnings div { margin: 2px 0; }
  .hardbox {
    margin-top: 22px; padding: 16px 18px; border-radius: 8px;
    border: 1px solid #f2c6c0; background: #fdf4f3;
  }
  .hardbox h3 { margin: 0 0 10px; font-size: 14px; color: var(--bad); text-transform: uppercase; letter-spacing: 0.05em; }
  .hardbox .item { border-left-color: var(--bad); }

  /* -- option tabs -- */
  .tabs { display: flex; gap: 6px; margin: 28px 0 0; flex-wrap: wrap; }
  .tab {
    border: 1px solid var(--line); background: var(--panel); color: var(--ink);
    padding: 9px 16px; border-radius: 7px 7px 0 0; cursor: pointer;
    font-size: 14px; font-weight: 600; border-bottom: none;
  }
  .tab .score { color: var(--muted); font-weight: 400; margin-left: 8px; }
  .tab[aria-selected="true"] { background: var(--ink); color: #fff; }
  .tab[aria-selected="true"] .score { color: #c9c9c4; }
  .panel {
    background: var(--panel); border: 1px solid var(--line);
    border-radius: 0 8px 8px 8px; padding: 24px;
  }
  .panel[hidden] { display: none; }

  /* -- score header -- */
  .scoreline { display: flex; align-items: baseline; gap: 20px; flex-wrap: wrap; }
  .total { font-size: 34px; font-weight: 700; letter-spacing: -0.02em; }
  .total small { font-size: 13px; font-weight: 400; color: var(--muted); margin-left: 6px; }
  .badge {
    font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 20px;
    text-transform: uppercase; letter-spacing: 0.04em;
  }
  .badge.ok { background: #e4f3ea; color: var(--good); }
  .badge.fail { background: #fbe6e3; color: var(--bad); }

  .headlines { display: flex; gap: 28px; margin: 20px 0 4px; flex-wrap: wrap; }
  .headline .v { font-size: 24px; font-weight: 700; }
  .headline .l { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .headline-scope { font-size: 12.5px; color: var(--muted); font-style: italic; margin: 0 0 4px; }
  .headline-scope:empty { display: none; }

  /* -- upsides / problems --
     Each entry is a <details> so the per-team occurrence list stays out of
     the way until asked for — collapsed by default, one line of name+delta
     to scan per rule. */
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 26px; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr; } }
  .col h3 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 10px; color: var(--muted); }
  .item { border-left: 3px solid var(--line); margin-bottom: 10px; }
  /* The hard-violation box below still renders `.item` as a plain <div> (it
     isn't collapsible), so it needs its own padding — the <details> version
     gets padding from summary.top/.item-body instead, further down. */
  .item:not(details) { padding: 8px 0 8px 12px; }
  .item.up { border-left-color: var(--good); }
  .item.down { border-left-color: var(--bad); }
  .item .top { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  details.item > summary.top { cursor: pointer; padding: 8px 8px 8px 4px; list-style: none; }
  details.item > summary.top::-webkit-details-marker { display: none; }
  details.item > summary.top::before {
    content: '▸'; display: inline-block; width: 12px; color: var(--muted);
    font-size: 10px; transition: transform 0.12s ease;
  }
  details.item[open] > summary.top::before { transform: rotate(90deg); }
  .item-body { padding: 0 8px 10px 16px; }
  .item .name { font-weight: 600; font-size: 14px; }
  .item .delta { font-variant-numeric: tabular-nums; font-weight: 700; font-size: 14px; white-space: nowrap; }
  .up .delta { color: var(--good); }
  .down .delta { color: var(--bad); }
  .desc { color: var(--muted); font-size: 13px; margin-top: 2px; }
  .examples, .occurrences { margin: 6px 0 0; padding-left: 18px; font-size: 13px; color: #45453f; }
  .examples li, .occurrences li { margin: 2px 0; }
  .occurrences .occ-count { color: var(--muted); font-variant-numeric: tabular-nums; }
  .more { color: var(--muted); font-size: 12px; font-style: italic; }

  /* -- rule description tooltip (icon shows description on hover/click) --
     Positioned as position:fixed (via JS, using the icon's own bounding
     rect) rather than absolute-relative-to-icon, so it can never be
     clipped by an ancestor's overflow — e.g. the horizontal-scroll
     wrapper around the full breakdown table. */
  .name-row { display: inline-flex; align-items: center; gap: 2px; }
  .info-wrap { display: inline-flex; vertical-align: middle; }
  .info-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 15px; height: 15px; margin-left: 5px; padding: 0; flex: none;
    border: none; border-radius: 50%; background: var(--line); color: var(--muted);
    font: 700 10px/1 -apple-system, BlinkMacSystemFont, sans-serif; cursor: pointer;
  }
  .info-icon:hover { background: var(--accent); color: #fff; }
  .info-icon:focus-visible { background: var(--accent); color: #fff; outline: 2px solid var(--accent); outline-offset: 2px; }
  .tooltip {
    position: fixed; z-index: 20;
    width: max-content; max-width: min(280px, 78vw);
    overflow-wrap: break-word; word-break: break-word;
    background: var(--ink); color: #fff; padding: 8px 10px; border-radius: 6px;
    font: 400 12.5px/1.4 -apple-system, BlinkMacSystemFont, sans-serif;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
    opacity: 0; visibility: hidden; transform: translateY(-4px); pointer-events: none;
    transition: opacity 0.12s ease, transform 0.12s ease;
  }
  .info-wrap:hover .tooltip,
  .info-wrap:focus-within .tooltip,
  .info-wrap.open .tooltip {
    opacity: 1; visibility: visible; transform: translateY(0); pointer-events: auto;
  }

  /* -- full breakdown table -- */
  details { margin-top: 26px; }
  summary { cursor: pointer; font-weight: 600; font-size: 14px; padding: 6px 0; }
  table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 14px; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); font-weight: 600; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .kind { font-size: 11px; padding: 2px 7px; border-radius: 4px; background: #eeeee9; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .kind.hard { background: #eef4fa; color: var(--accent); }
  tr.violated td { background: #fdf4f3; }

  /* -- search difficulty (issue #34) -- */
  .search-stats { margin-top: 16px; }
  .search-stats > summary { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .difficulty-pill {
    font-size: 11px; padding: 2px 8px; border-radius: 10px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.04em;
  }
  .difficulty-easy { background: #e8f6ee; color: var(--good); }
  .difficulty-moderate { background: #fdf6ea; color: var(--warn); }
  .difficulty-hard { background: #fdf0ee; color: var(--bad); }
  .search-stats .desc { margin-top: 6px; }

  /* -- fairness across teams -- */
  .fairness-row { margin: 14px 0 0; padding: 12px 14px; border: 1px solid var(--line); border-radius: 8px; }
  .fairness-row.flagged { border-color: #f0cf98; background: #fdf8ef; }
  .fairness-row .head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .fairness-row .fname { font-weight: 600; font-size: 13.5px; }
  .fairness-row .flag { font-size: 11.5px; color: var(--warn); font-weight: 700; }
  .fairness-bars { margin-top: 10px; display: flex; flex-direction: column; gap: 5px; }
  .fairness-bar { display: grid; grid-template-columns: 150px 1fr 28px; align-items: center; gap: 8px; font-size: 12.5px; }
  .fairness-bar .flabel { color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fairness-bar .ftrack { display: block; background: #eeeee9; border-radius: 4px; height: 8px; overflow: hidden; }
  .fairness-bar .ffill { display: block; background: var(--accent); height: 100%; border-radius: 4px; }
  .fairness-bar .fcount { text-align: right; font-variant-numeric: tabular-nums; color: var(--muted); }

  /* -- calendar controls: view toggle + club filter -- */
  .controls { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; margin-top: 26px; }
  .view-toggle { display: flex; gap: 6px; flex-wrap: wrap; }
  .view-btn {
    border: 1px solid var(--line); background: var(--panel); color: var(--ink);
    padding: 6px 12px; border-radius: 20px; cursor: pointer; font-size: 12.5px; font-weight: 600;
  }
  .view-btn.active { background: var(--ink); color: #fff; border-color: var(--ink); }
  .club-filter { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
  .club-filter select {
    font: inherit; padding: 5px 8px; border-radius: 6px; border: 1px solid var(--line);
    background: var(--panel); color: var(--ink);
  }
  .club-hidden { display: none !important; }

  /* -- calendar -- */
  .cal-wrap { overflow-x: auto; }
  .view-pane[hidden] { display: none; }
  .comp { margin-top: 30px; }
  .comp h3 { font-size: 16px; margin: 0 0 2px; }
  .comp .meta { color: var(--muted); font-size: 13px; margin-bottom: 12px; }
  .round { border-top: 1px solid var(--line); padding: 10px 0; display: grid; grid-template-columns: 130px 1fr; gap: 14px; }
  .round .rlabel { font-size: 12px; color: var(--muted); }
  .round .rlabel b { display: block; color: var(--ink); font-size: 14px; }
  .fixtures { display: flex; flex-wrap: wrap; gap: 8px; }
  /* `gap` alone spaces every child of the card (date, tag, swatches, names,
     the "v" separator, the pair dot) evenly — issue #61 asked for more
     breathing room here, so this replaced a set of per-element margins that
     made the card read as one cramped run of text. */
  .fx {
    display: inline-flex; align-items: center; gap: 5px;
    border: 1px solid var(--line); border-radius: 7px; padding: 7px 12px;
    font-size: 13px; background: #fcfcfb; white-space: nowrap;
  }
  .fx .d { color: var(--muted); font-variant-numeric: tabular-nums; }
  .fx .h { font-weight: 600; }
  .fx .vs { color: var(--muted); }
  .fx.paired { border-color: var(--good); background: #f1f9f4; }
  .comp-tag {
    /* Short names (e.g. "NM(m)") carry their own deliberate case, so no
       text-transform here — unlike a full competition name, which would
       read fine either way. */
    font-size: 10px; padding: 1px 6px; border-radius: 10px;
    background: #eeeee9; color: var(--muted); letter-spacing: 0.03em;
  }
  /* Home = square, away = diamond, both filled with the club's own colour
     (data/clubs.yml). Fixed pixel sizes rather than a text glyph — a
     unicode glyph here previously rendered visibly larger than the
     surrounding text depending on the reader's font, which is what made
     some fixtures look like they had "bigger text" than others. */
  .swatch, .swatch-diamond, .swatch-neutral {
    display: inline-block; width: 8px; height: 8px;
    vertical-align: middle; flex: none;
  }
  .swatch { border-radius: 2px; }
  .swatch-diamond { border-radius: 1px; transform: rotate(45deg); }
  /* Cup final only: neutral ground, so neither the square (home) nor the
     diamond (away) marker applies. */
  .swatch-neutral { border-radius: 50%; }
  .pair-badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: 13px; height: 13px; border-radius: 50%; vertical-align: middle;
    background: var(--good); flex: none;
  }
  .fx-demo {
    display: inline-block; width: 22px; height: 14px; margin-right: 5px;
    border: 1px solid var(--good); background: #f1f9f4; border-radius: 4px;
    vertical-align: middle;
  }
  .legend { display: flex; gap: 16px; flex-wrap: wrap; font-size: 12.5px; color: var(--muted); margin: 14px 0 0; align-items: center; }
  footer { margin-top: 40px; color: var(--muted); font-size: 12.5px; }

  /* -- month calendar (issue #77) -- */
  .month { margin-top: 26px; }
  .month h4 { margin: 0 0 8px; font-size: 15px; }
  .month-grid { display: flex; flex-direction: column; gap: 3px; min-width: 420px; }
  .month-grid-row { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; }
  .month-grid-head {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted);
    text-align: center; padding-bottom: 2px;
  }
  .cal-day {
    display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
    gap: 4px; min-height: 52px; padding: 6px 2px; border: 1px solid var(--line); border-radius: 6px;
    background: var(--panel); color: var(--ink); font: inherit; cursor: pointer;
  }
  .cal-day:hover, .cal-day:focus-visible { border-color: var(--accent); outline: none; }
  .cal-day.selected { border-color: var(--accent); background: #eaf2f8; }
  .cal-day.out-month { color: var(--muted); background: #fbfbfa; }
  .cal-daynum { font-size: 12.5px; font-variant-numeric: tabular-nums; }
  .cal-dots { display: flex; gap: 3px; flex-wrap: wrap; justify-content: center; min-height: 8px; }
  .cal-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; }
  .day-details { margin-top: 20px; border-top: 1px solid var(--line); padding-top: 14px; }
  .day-detail-empty { color: var(--muted); font-size: 13.5px; }
  .day-detail .rlabel { margin-bottom: 8px; }
  .day-detail .rlabel b { display: block; color: var(--ink); font-size: 14px; }
  .day-detail .fixtures { display: flex; flex-direction: column; }
  .day-row { display: flex; align-items: center; gap: 6px; font-size: 13px; padding: 5px 0; border-bottom: 1px solid var(--line); }
  .day-row:last-child { border-bottom: none; }
  .day-row .vs { color: var(--muted); margin: 0 1px; }
  .day-row .d { margin-left: auto; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }

  @media (max-width: 480px) {
    .round { grid-template-columns: 1fr; gap: 4px; }
    .fx { white-space: normal; }
    .fairness-bar { grid-template-columns: 110px 1fr 24px; }
    .month-grid { min-width: 0; }
    .cal-day { min-height: 40px; padding: 4px 1px; }
  }
</style>
</head>
<body>
{% set ns = namespace(tooltip_id=0) %}
<div class="wrap">

<header>
  <h1>{{ title }}</h1>
  <div class="sub">
    {{ season.start.strftime('%d %B %Y') }} – {{ season.end.strftime('%d %B %Y') }}
    · solver <b>{{ result.solver }}</b>
    {% if result.iterations %}· {{ '{:,}'.format(result.iterations) }} iterations{% endif %}
    · {{ '%.1f'|format(result.elapsed_s) }}s
  </div>
</header>

{% if result.notes %}
<div class="notes">
  {% for note in result.notes %}<div>{{ note }}</div>{% endfor %}
</div>
{% endif %}

{% if warnings %}
<div class="warnings">
  <div style="font-weight:700;margin-bottom:4px">Coverage notes</div>
  {% for warning in warnings %}<div>⚠ {{ warning }}</div>{% endfor %}
</div>
{% endif %}

{% if season_exclusions %}
<details>
  <summary>
    Season exclusions
    <span style="font-weight:400;color:var(--muted)">
      · {{ season_exclusions|length }} entr{{ 'y' if season_exclusions|length == 1 else 'ies' }}
    </span>
  </summary>
  <div class="item-body">
    {% for entry in season_exclusions %}
    <div class="desc">
      {{ entry.start.strftime('%d %b %Y') }}{% if entry.end != entry.start %} – {{ entry.end.strftime('%d %b %Y') }}{% endif %}
      {%- if entry.venue_label %} ({{ entry.venue_label }}){% endif %}
      {%- if entry.reason %} — {{ entry.reason }}{% endif %}
    </div>
    {% endfor %}
  </div>
</details>
{% endif %}

{% if search_stats %}
<details class="search-stats">
  <summary>
    How hard was this to schedule?
    <span class="difficulty-pill difficulty-{{ search_stats.difficulty }}">{{ search_stats.difficulty }}</span>
    <span style="font-weight:400;color:var(--muted)">
      · {{ '{:,}'.format(search_stats.investigated) }} scenarios investigated ·
      {{ '%.0f'|format(search_stats.feasible_pct) }}% viable
    </span>
  </summary>
  <div class="item-body">
    <div class="desc">{{ search_stats.difficulty_label }}</div>
    <div class="desc">
      {{ '{:,}'.format(search_stats.feasible) }} scenario{{ '' if search_stats.feasible == 1 else 's' }} came out viable,
      {{ '{:,}'.format(search_stats.hard_violation_scenarios) }} hit at least one hard-rule violation
      ({{ '%.0f'|format(search_stats.hard_violation_pct) }}% of everything tried).
    </div>
    {% if search_stats.breakdown %}
    <div style="font-weight:700;margin:14px 0 6px;font-size:13px">Where the dead ends came from</div>
    <div class="fairness-bars">
      {% for row in search_stats.breakdown %}
      <div class="fairness-bar" title="{{ row.description }}">
        <span class="flabel">{{ row.id.replace('_', ' ') }}</span>
        <span class="ftrack"><span class="ffill" style="width:{{ row.pct }}%"></span></span>
        <span class="fcount">{{ '{:,}'.format(row.count) }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</details>
{% endif %}

<div class="tabs" role="tablist">
  {% for option in options %}
  <button class="tab" role="tab" data-panel="panel-{{ loop.index }}"
          aria-selected="{{ 'true' if loop.first else 'false' }}">
    {{ option.label }}<span class="score">{{ '%.0f'|format(option.points) }}</span>
  </button>
  {% endfor %}
</div>

{% macro fx_card(match, show_competition=False) %}
<span class="fx {% if match.paired %}paired{% endif %}"
      data-clubs="{{ match.home_club }} {{ match.away_club }}"
      data-competition="{{ match.competition_id }}"
      title="{{ match.venue }}">
  <span class="d">{{ match.weekday }} {{ match.date.strftime('%d/%m') }}{% if match.kickoff_time %} {{ match.kickoff_time }}{% endif %}</span>
  {% if show_competition %}
  <span class="comp-tag" style="background:{{ match.comp_bg }};color:{{ match.comp_fg }}" title="{{ match.competition_name }}">{{ match.competition_short }}</span>
  {% endif %}
  <span class="swatch" style="background:{{ match.color }}" aria-hidden="true"></span>
  <span class="h" title="{{ match.home }}">{{ match.home_short }}</span>
  <span class="vs">v</span>
  <span class="swatch-diamond" style="background:{{ match.away_color }}" aria-hidden="true"></span>
  <span title="{{ match.away }}">{{ match.away_short }}</span>
  {% if match.paired %}
  <span class="pair-badge" role="img" aria-label="back-to-back home day with the club's other team"></span>
  {% endif %}
</span>
{% endmacro %}

{% macro cup_fx_card(fixture, show_competition=False) %}
<span class="fx" data-clubs="{{ fixture.club_id }}" title="{{ fixture.venue_label }}">
  <span class="d">{{ fixture.weekday }} {{ fixture.date.strftime('%d/%m') }}</span>
  {% if show_competition %}
  <span class="comp-tag" style="background:{{ fixture.comp_bg }};color:{{ fixture.comp_fg }}" title="{{ fixture.competition_name }}">{{ fixture.competition_short }}</span>
  {% endif %}
  {% if fixture.venue_type == 'home' %}
  <span class="swatch" style="background:{{ fixture.color }}" aria-hidden="true"></span>
  {% elif fixture.venue_type == 'away' %}
  <span class="swatch-diamond" style="background:{{ fixture.color }}" aria-hidden="true"></span>
  {% else %}
  <span class="swatch-neutral" style="background:{{ fixture.color }}" aria-hidden="true"></span>
  {% endif %}
  <span class="h" title="{{ fixture.team_full }}">{{ fixture.team }}</span>
  <span class="vs">v TBD</span>
</span>
{% endmacro %}

{% macro european_fx_card(fixture, show_competition=False) %}
<span class="fx" data-clubs="{{ fixture.club_id }}" title="{{ fixture.venue_label }}">
  <span class="d">{{ fixture.weekday }} {{ fixture.date.strftime('%d/%m') }}</span>
  {% if show_competition %}
  <span class="comp-tag" style="background:{{ fixture.comp_bg }};color:{{ fixture.comp_fg }}" title="{{ fixture.competition_name }}">{{ fixture.competition_short }}</span>
  {% endif %}
  {% if fixture.venue_type == 'home' %}
  <span class="swatch" style="background:{{ fixture.color }}" aria-hidden="true"></span>
  {% elif fixture.venue_type == 'away' %}
  <span class="swatch-diamond" style="background:{{ fixture.color }}" aria-hidden="true"></span>
  {% else %}
  <span class="swatch" style="background:{{ fixture.color }};opacity:0.4" aria-hidden="true"></span>
  {% endif %}
  <span class="h" title="{{ fixture.team_full }}">{{ fixture.team }}</span>
  <span class="vs">v {{ fixture.opponent }}</span>
</span>
{% endmacro %}

{% macro day_row(match) %}
{# Compact one-line row for the month calendar's day-detail blocks (issue
   #77) — a drill-down list, not the primary view, so it skips the full
   fx_card/cup_fx_card/european_fx_card markup (date text, venue tooltip) to
   keep the per-day blocks the report duplicates three times over (once per
   candidate option) from bloating the page. #}
<div class="day-row"
     data-clubs="{{ (match.home_club ~ ' ' ~ match.away_club) if match.home_club is defined else match.club_id }}">
  <span class="comp-tag" style="background:{{ match.comp_bg }};color:{{ match.comp_fg }}" title="{{ match.competition_name }}">{{ match.competition_short }}</span>
  {% if match.is_cup %}
  <span class="swatch{{ '-diamond' if match.venue_type == 'away' else ('-neutral' if match.venue_type == 'neutral' else '') }}"
        style="background:{{ match.color }}" aria-hidden="true"></span>
  <span>{{ match.team }}</span><span class="vs">v TBD</span>
  {% elif match.is_european %}
  <span class="swatch{{ '-diamond' if match.venue_type == 'away' else '' }}"
        style="background:{{ match.color }}{{ ';opacity:0.4' if match.venue_type == 'unknown' else '' }}" aria-hidden="true"></span>
  <span>{{ match.team }}</span><span class="vs">v {{ match.opponent }}</span>
  {% else %}
  <span class="swatch" style="background:{{ match.color }}" aria-hidden="true"></span>
  <span>{{ match.home_short }}</span><span class="vs">v</span>
  <span class="swatch-diamond" style="background:{{ match.away_color }}" aria-hidden="true"></span>
  <span>{{ match.away_short }}</span>
  {% endif %}
  {% if match.kickoff_time %}<span class="d">{{ match.kickoff_time }}</span>{% endif %}
</div>
{% endmacro %}

{% for option in options %}
<section class="panel" id="panel-{{ loop.index }}" role="tabpanel" {% if not loop.first %}hidden{% endif %}>

  <div class="scoreline">
    <div class="total">{{ '%.0f'|format(option.points) }}<small>/ 100 · raw soft score {{ '%.1f'|format(option.soft_total) }}</small></div>
    {% if option.feasible %}
      <span class="badge ok">feasible · 0 hard violations</span>
    {% else %}
      <span class="badge fail">{{ option.hard_violations }} hard violation{{ '' if option.hard_violations == 1 else 's' }}</span>
    {% endif %}
  </div>

  <div class="headline-scope"></div>
  <div class="headlines" data-global="{{ option.headlines_json }}" data-club="{{ option.club_headlines_json }}">
    {% for headline in option.headlines %}
    <div class="headline">
      <div class="v">{{ headline.value }}</div>
      <div class="l">{{ headline.label }}</div>
    </div>
    {% endfor %}
  </div>

  {% if option.hard_violation_detail %}
  <div class="hardbox">
    <h3>Broken hard rules — this schedule is not usable as-is</h3>
    {% for row in option.hard_violation_detail %}
    <div class="item down">
      <div class="top">
        <span class="name-row">
          <span class="name">{{ row.id.replace('_', ' ') }}</span>
          {% set ns.tooltip_id = ns.tooltip_id + 1 %}
          <span class="info-wrap">
            <button type="button" class="info-icon" aria-label="{{ row.id.replace('_', ' ') }} description" aria-describedby="tt-{{ ns.tooltip_id }}">i</button>
            <span class="tooltip" id="tt-{{ ns.tooltip_id }}" role="tooltip">{{ row.description }}</span>
          </span>
        </span>
        <span class="delta">{{ row.count }} violation{{ '' if row.count == 1 else 's' }}</span>
      </div>
      {% if row.examples %}
      <ul class="examples">{% for example in row.examples %}<li>{{ example }}</li>{% endfor %}</ul>
      {% if row.more %}<div class="more">…and {{ row.more }} more</div>{% endif %}
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="cols">
    <div class="col">
      <h3>{{ 'Every upside' if option.full else 'Biggest upsides' }}</h3>
      {% for row in option.upsides %}
      <details class="item up">
        <summary class="top">
          <span class="name-row">
            <span class="name">{{ row.id.replace('_', ' ') }}</span>
            {% set ns.tooltip_id = ns.tooltip_id + 1 %}
            <span class="info-wrap">
              <button type="button" class="info-icon" aria-label="{{ row.id.replace('_', ' ') }} description" aria-describedby="tt-{{ ns.tooltip_id }}">i</button>
              <span class="tooltip" id="tt-{{ ns.tooltip_id }}" role="tooltip">{{ row.description }}</span>
            </span>
          </span>
          <span class="delta">+{{ '%.0f'|format(row.total) }}</span>
        </summary>
        <div class="item-body">
          {% if row.occurrences %}
          <ul class="occurrences">
            {% for occ in row.occurrences %}<li>{{ occ.label }} <span class="occ-count">×{{ occ.count }}</span></li>{% endfor %}
          </ul>
          {% else %}
          <div class="desc">×{{ row.count }}</div>
          {% endif %}
        </div>
      </details>
      {% else %}
      <div class="desc">Nothing scored positively.</div>
      {% endfor %}
    </div>

    <div class="col">
      <h3>{{ 'Every problem (including the hard rules above)' if option.full else 'Biggest problems' }}</h3>
      {% for row in option.problems %}
      <details class="item down">
        <summary class="top">
          <span class="name-row">
            <span class="name">{{ row.id.replace('_', ' ') }}</span>
            {% set ns.tooltip_id = ns.tooltip_id + 1 %}
            <span class="info-wrap">
              <button type="button" class="info-icon" aria-label="{{ row.id.replace('_', ' ') }} description" aria-describedby="tt-{{ ns.tooltip_id }}">i</button>
              <span class="tooltip" id="tt-{{ ns.tooltip_id }}" role="tooltip">{{ row.description }}</span>
            </span>
          </span>
          <span class="delta">{{ '%.0f'|format(row.total) }}</span>
        </summary>
        <div class="item-body">
          {% if row.occurrences %}
          <ul class="occurrences">
            {% for occ in row.occurrences %}<li>{{ occ.label }} <span class="occ-count">×{{ occ.count }}</span></li>{% endfor %}
          </ul>
          {% else %}
          <div class="desc">×{{ row.count }}</div>
          {% endif %}
        </div>
      </details>
      {% else %}
      <div class="desc">Nothing scored negatively.</div>
      {% endfor %}
    </div>
  </div>

  <details>
    <summary>Full score breakdown — every rule</summary>
    <div class="cal-wrap">
    <table>
      <thead>
        <tr><th>Rule</th><th>Type</th><th class="num">Contribution</th><th class="num">Events</th><th>Examples</th></tr>
      </thead>
      <tbody>
      {% for row in option.breakdown %}
        <tr {% if row.kind == 'hard' and row.count %}class="violated"{% endif %}>
          <td>
            <span class="name-row">
              <b>{{ row.id.replace('_', ' ') }}</b>
              {% set ns.tooltip_id = ns.tooltip_id + 1 %}
              <span class="info-wrap">
                <button type="button" class="info-icon" aria-label="{{ row.id.replace('_', ' ') }} description" aria-describedby="tt-{{ ns.tooltip_id }}">i</button>
                <span class="tooltip" id="tt-{{ ns.tooltip_id }}" role="tooltip">{{ row.description }}</span>
              </span>
            </span>
          </td>
          <td><span class="kind {{ row.kind }}">{{ row.kind }}</span></td>
          <td class="num">{{ '%+.1f'|format(row.total) if row.total else '—' }}</td>
          <td class="num">{{ row.count }}</td>
          <td>
            {% if row.examples %}
            <ul class="examples" style="margin:0;padding-left:16px">
              {% for example in row.examples %}<li>{{ example }}</li>{% endfor %}
            </ul>
            {% if row.more %}<span class="more">…and {{ row.more }} more</span>{% endif %}
            {% else %}—{% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </details>

  {% if option.fairness %}
  <details>
    <summary>Fairness across teams — is any one team favoured or penalised?</summary>
    <div class="desc" style="margin-top:8px">
      Per-rule counts for every team (or, for the two club-coupling rules,
      every dual club). A rule flagged ⚠ has a wider gap between its
      best- and worst-treated team than the rule's own average — worth a
      look before this schedule is accepted.
    </div>
    {% for row in option.fairness %}
    <div class="fairness-row {{ 'flagged' if row.flagged }}">
      <div class="head">
        <span class="fname">{{ row.id.replace('_', ' ') }}</span>
        {% if row.flagged %}<span class="flag">⚠ uneven — {{ row.min }}–{{ row.max }} across entries</span>{% endif %}
      </div>
      <div class="desc">{{ row.description }}</div>
      <div class="fairness-bars">
        {% for entry in row.entries %}
        <div class="fairness-bar">
          <span class="flabel" title="{{ entry.label }}">{{ entry.label }}</span>
          <span class="ftrack"><span class="ffill" style="width:{{ (100 * entry.count / row.max) if row.max else 0 }}%"></span></span>
          <span class="fcount">{{ entry.count }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </details>
  {% endif %}

  <div class="controls">
    <div class="view-toggle">
      <button type="button" class="view-btn" data-view="by-competition">By competition</button>
      <button type="button" class="view-btn" data-view="month-calendar">Month calendar</button>
      <button type="button" class="view-btn" data-view="combined-calendar">Combined · calendar</button>
      <button type="button" class="view-btn" data-view="combined-list">Combined · list</button>
    </div>
    <label class="club-filter">
      Club
      <select class="club-select">
        <option value="">All clubs</option>
        {% for club in all_clubs %}
        <option value="{{ club.id }}">{{ club.name }}</option>
        {% endfor %}
      </select>
    </label>
  </div>

  <div class="legend">
    <span><span class="fx-demo" aria-hidden="true"></span>green = back-to-back home day for a dual club</span>
    <span><span class="pair-badge" style="margin-right:5px" aria-hidden="true"></span>dot = this fixture is one of that back-to-back pair</span>
    <span><span class="swatch" style="background:var(--ink);margin-right:5px" aria-hidden="true"></span>square = home club colour</span>
    <span><span class="swatch-diamond" style="background:var(--ink);margin-right:5px" aria-hidden="true"></span>diamond = away club colour</span>
    <span><span class="swatch-neutral" style="background:var(--ink);margin-right:5px" aria-hidden="true"></span>circle = cup final, neutral ground</span>
  </div>

  <div class="cal-wrap view-pane" data-view="by-competition">
  {% for competition in option.by_competition %}
    <div class="comp">
      <h3>{{ competition.name }}</h3>
      {% if competition.is_cup %}
      <div class="meta">
        {{ competition.match_count }} teams entered · opponent drawn closer to each round, so dates
        are per-team, not fixtures · home/away assumed per NM rules (away for the first three
        rounds, then alternating; final always neutral)
      </div>
      {% for round in competition.rounds %}
      <div class="round">
        <div class="rlabel" {% if round.note %}title="{{ round.note }}"{% endif %}>
          <b>{{ round.name }}</b>
          {{ round.dates }} · {{ round.venue_summary }}
        </div>
        <div class="fixtures">
          {% for fixture in round.fixtures %}{{ cup_fx_card(fixture) }}{% endfor %}
        </div>
      </div>
      {% endfor %}
      {% elif competition.is_european %}
      <div class="meta">
        {% if competition.is_main_tournament %}
        {{ competition.match_count }} matchday(s)/round(s) tracked · every reachable team shown
        with opponent "TBD" — pairings aren't drawn this far ahead
        {% else %}
        {{ competition.match_count }} qualifying round(s) tracked · opponent and home/away shown
        where UEFA has confirmed them, "TBD" where the tie is still conditional on another result
        {% endif %}
      </div>
      {% for round in competition.rounds %}
      <div class="round">
        <div class="rlabel" {% if round.note %}title="{{ round.note }}"{% endif %}>
          <b>{{ round.name }}</b>
          {{ round.dates }}
        </div>
        <div class="fixtures">
          {% for fixture in round.fixtures %}{{ european_fx_card(fixture) }}{% endfor %}
        </div>
      </div>
      {% endfor %}
      {% else %}
      <div class="meta">
        {{ competition.match_count }} matches over {{ competition.rounds|length }} rounds ·
        prefers {{ competition.preferred_weekday }}
      </div>
      {% for round in competition.rounds %}
      <div class="round">
        <div class="rlabel">
          <b>Round {{ round.index }}</b>
          {{ round.dates }} · leg {{ round.leg }}
        </div>
        <div class="fixtures">
          {% for match in round.matches %}{{ fx_card(match) }}{% endfor %}
        </div>
      </div>
      {% endfor %}
      {% endif %}
    </div>
  {% endfor %}
  </div>

  <div class="cal-wrap view-pane" data-view="month-calendar" hidden>
    <div class="desc" style="margin-top:8px">
      One dot per competition with something on that day (a match, cup round, or European leg) —
      tap a day to see its games below.
    </div>
    {% if option.month_calendar %}
    {% if option.calendar_legend %}
    <div class="legend">
      {% for comp in option.calendar_legend %}
      <span><span class="cal-dot" style="background:{{ comp.color }}" aria-hidden="true"></span><b>{{ comp.short }}</b> {{ comp.name }}</span>
      {% endfor %}
    </div>
    {% endif %}
    {% for month in option.month_calendar %}
    <div class="month">
      <h4>{{ month.label }}</h4>
      <div class="month-grid">
        <div class="month-grid-row month-grid-head">
          <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
        </div>
        {% for week in month.weeks %}
        <div class="month-grid-row">
          {% for day in week %}
          <button type="button" class="cal-day {{ '' if day.in_month else 'out-month' }}"
                  data-date="{{ day.date_iso }}" aria-pressed="false"
                  aria-label="{{ day.date_iso }}{% if day.dots %}: {{ day.dots | map(attribute='name') | join(', ') }}{% endif %}">
            <span class="cal-daynum">{{ day.day_num }}</span>
            <span class="cal-dots">
              {% for dot in day.dots %}
              <span class="cal-dot" data-clubs="{{ dot.club_ids | join(' ') }}"
                    style="background:{{ dot.color }}" title="{{ dot.name }}" aria-hidden="true"></span>
              {% endfor %}
            </span>
          </button>
          {% endfor %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
    <div class="day-details">
      <div class="day-detail-empty">Tap a day above to see its games here.</div>
      {% for day in option.month_calendar_details %}
      <div class="day-detail" data-date="{{ day.date_iso }}" hidden>
        <div class="rlabel"><b>{{ day.label }}</b></div>
        <div class="fixtures">
          {% for match in day.matches %}{{ day_row(match) }}{% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="desc">Nothing scheduled yet.</div>
    {% endif %}
  </div>

  <div class="cal-wrap view-pane" data-view="combined-calendar" hidden>
    <div class="desc" style="margin-top:8px">
      Every league's matches and every cup's per-team round dates, interleaved
      by date. A cup round has no fixture-level pairing yet (the opponent is
      drawn closer to each round), so those cards show "v TBD" — see
      "By competition" for the venue rule behind each round.
    </div>
    {% for week in option.combined_calendar %}
    <div class="round">
      <div class="rlabel">
        <b>{{ week.label }}</b>
        {{ week.dates }}
      </div>
      <div class="fixtures">
        {% for match in week.matches %}
          {% if match.is_cup %}{{ cup_fx_card(match, show_competition=True) }}
          {% elif match.is_european %}{{ european_fx_card(match, show_competition=True) }}
          {% else %}{{ fx_card(match, show_competition=True) }}{% endif %}
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="cal-wrap view-pane" data-view="combined-list" hidden>
    <table>
      <thead>
        <tr><th>Date</th><th>Competition</th><th>Home</th><th></th><th>Away</th><th>Venue</th></tr>
      </thead>
      <tbody>
      {% for match in option.combined_list %}
      {% if match.is_cup %}
      <tr class="fx-row" data-clubs="{{ match.club_id }}" data-competition="{{ match.competition_id }}">
        <td>{{ match.weekday }} {{ match.date.strftime('%d %b %Y') }}</td>
        <td><span class="comp-tag" style="background:{{ match.comp_bg }};color:{{ match.comp_fg }}" title="{{ match.competition_name }}">{{ match.competition_short }}</span></td>
        <td>
          {% if match.venue_type == 'home' %}
          <span class="swatch" style="background:{{ match.color }};margin-right:5px" aria-hidden="true"></span>
          {% elif match.venue_type == 'away' %}
          <span class="swatch-diamond" style="background:{{ match.color }};margin-right:5px" aria-hidden="true"></span>
          {% else %}
          <span class="swatch-neutral" style="background:{{ match.color }};margin-right:5px" aria-hidden="true"></span>
          {% endif %}
          <span title="{{ match.team_full }}">{{ match.team }}</span>
        </td>
        <td style="color:var(--muted)">v</td>
        <td style="color:var(--muted)">TBD ({{ match.round_name }})</td>
        <td>{{ match.venue_label }}</td>
      </tr>
      {% elif match.is_european %}
      <tr class="fx-row" data-clubs="{{ match.club_id }}" data-competition="{{ match.competition_id }}">
        <td>{{ match.weekday }} {{ match.date.strftime('%d %b %Y') }}</td>
        <td><span class="comp-tag" style="background:{{ match.comp_bg }};color:{{ match.comp_fg }}" title="{{ match.competition_name }}">{{ match.competition_short }}</span></td>
        <td>
          {% if match.venue_type == 'home' %}
          <span class="swatch" style="background:{{ match.color }};margin-right:5px" aria-hidden="true"></span>
          {% elif match.venue_type == 'away' %}
          <span class="swatch-diamond" style="background:{{ match.color }};margin-right:5px" aria-hidden="true"></span>
          {% else %}
          <span class="swatch" style="background:{{ match.color }};opacity:0.4;margin-right:5px" aria-hidden="true"></span>
          {% endif %}
          <span title="{{ match.team_full }}">{{ match.team }}</span>
        </td>
        <td style="color:var(--muted)">v</td>
        <td style="color:var(--muted)">{{ match.opponent }} ({{ match.round_name }})</td>
        <td>{{ match.venue_label }}</td>
      </tr>
      {% else %}
      <tr class="fx-row" data-clubs="{{ match.home_club }} {{ match.away_club }}" data-competition="{{ match.competition_id }}">
        <td>{{ match.weekday }} {{ match.date.strftime('%d %b %Y') }}{% if match.kickoff_time %} {{ match.kickoff_time }}{% endif %}</td>
        <td><span class="comp-tag" style="background:{{ match.comp_bg }};color:{{ match.comp_fg }}" title="{{ match.competition_name }}">{{ match.competition_short }}</span></td>
        <td>
          <span class="swatch" style="background:{{ match.color }};margin-right:5px" aria-hidden="true"></span>
          <span title="{{ match.home }}">{{ match.home_short }}</span>
        </td>
        <td style="color:var(--muted)">v</td>
        <td>
          <span class="swatch-diamond" style="background:{{ match.away_color }};margin-right:5px" aria-hidden="true"></span>
          <span title="{{ match.away }}">{{ match.away_short }}</span>
        </td>
        <td>{{ match.venue }}</td>
      </tr>
      {% endif %}
      {% endfor %}
      </tbody>
    </table>
  </div>

</section>
{% endfor %}

<footer>
  Generated by terminliste. Club, venue and league data is assembled from public sources
  and marked <code>verified: false</code> — check <code>data/</code> before using this for anything real.
</footer>

</div>

<script>
  document.querySelectorAll('.tab').forEach(function (tab) {
    tab.addEventListener('click', function () {
      document.querySelectorAll('.tab').forEach(function (other) {
        other.setAttribute('aria-selected', String(other === tab));
      });
      document.querySelectorAll('.panel').forEach(function (panel) {
        panel.hidden = panel.id !== tab.dataset.panel;
      });
    });
  });

  // Per-panel view toggle (by competition / combined calendar / combined
  // list) and club filter. Scoped to `panel` throughout — with more than one
  // schedule option on the page, each panel needs its own independent view
  // and filter state, or switching the outer option tabs would leak one
  // panel's selection into another.
  document.querySelectorAll('.panel').forEach(function (panel) {
    var viewButtons = panel.querySelectorAll('.view-btn');
    var clubSelect = panel.querySelector('.club-select');
    if (!viewButtons.length) return;

    // Headline numbers (matches on preferred weekday, back-to-back home
    // days, ...) restated for the selected club, in place of the season-wide
    // totals — the JSON payloads are rendered server-side once per option
    // (see `club_headlines_json` in report/render.py) and swapped in here so
    // filtering never needs a page reload.
    var headlinesEl = panel.querySelector('.headlines');
    var headlineScope = panel.querySelector('.headline-scope');
    var globalHeadlines = headlinesEl ? JSON.parse(headlinesEl.dataset.global || '[]') : [];
    var clubHeadlines = headlinesEl ? JSON.parse(headlinesEl.dataset.club || '{}') : {};

    function renderHeadlines(rows) {
      if (!headlinesEl) return;
      headlinesEl.innerHTML = '';
      rows.forEach(function (row) {
        var tile = document.createElement('div');
        tile.className = 'headline';
        var v = document.createElement('div');
        v.className = 'v';
        v.textContent = row.value;
        var l = document.createElement('div');
        l.className = 'l';
        l.textContent = row.label;
        tile.appendChild(v);
        tile.appendChild(l);
        headlinesEl.appendChild(tile);
      });
    }

    function applyClubFilter() {
      var value = clubSelect ? clubSelect.value : '';
      panel.querySelectorAll('[data-clubs]').forEach(function (el) {
        var clubs = el.dataset.clubs ? el.dataset.clubs.split(' ') : [];
        var visible = !value || clubs.indexOf(value) !== -1;
        el.classList.toggle('club-hidden', !visible);
      });
      // Hide now-empty round/week groups and competitions rather than
      // leaving blank labels behind. Cup fixtures carry `data-clubs` too
      // (one entry per entered team, not per pairing), so the same filter
      // reaches them.
      panel.querySelectorAll('.round').forEach(function (round) {
        var fixtures = round.querySelectorAll('.fx[data-clubs]');
        if (!fixtures.length) return;
        var anyVisible = round.querySelector('.fx[data-clubs]:not(.club-hidden)');
        round.classList.toggle('club-hidden', !anyVisible);
      });
      panel.querySelectorAll('.comp').forEach(function (comp) {
        var rounds = comp.querySelectorAll('.round');
        if (!rounds.length) return;
        var anyVisible = comp.querySelector('.round:not(.club-hidden)');
        comp.classList.toggle('club-hidden', !anyVisible);
      });
      // Same rollup for the month calendar's day-detail blocks — a club's
      // dots and rows carry `data-clubs` too (via the generic sweep above),
      // so a day with nothing for the selected club collapses rather than
      // showing an empty heading (issue #77 review).
      updateDayDetailEmptyState();
      if (value && clubHeadlines[value]) {
        renderHeadlines(clubHeadlines[value]);
        if (headlineScope) {
          var label = clubSelect.options[clubSelect.selectedIndex].text;
          headlineScope.textContent = label + '’s matches only:';
        }
      } else {
        renderHeadlines(globalHeadlines);
        if (headlineScope) headlineScope.textContent = '';
      }
    }

    function setView(name) {
      viewButtons.forEach(function (btn) {
        var active = btn.dataset.view === name;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
      panel.querySelectorAll('.view-pane').forEach(function (pane) {
        pane.hidden = pane.dataset.view !== name;
      });
    }

    viewButtons.forEach(function (btn) {
      btn.addEventListener('click', function () { setView(btn.dataset.view); });
    });
    if (clubSelect) {
      clubSelect.addEventListener('change', applyClubFilter);
    }

    // Month calendar: tapping a day cell shows that day's games in the
    // per-day detail blocks rendered below the grid (issue #77) — every
    // block starts hidden, and a tap shows the one matching the clicked
    // date while re-hiding whichever was shown before.
    var calDays = panel.querySelectorAll('.cal-day[data-date]');
    var dayDetails = panel.querySelectorAll('.day-detail[data-date]');
    var dayDetailEmpty = panel.querySelector('.day-detail-empty');

    // Re-derives whether the currently *selected* day still has anything to
    // show once the club filter (which hides individual `.day-row`s, same
    // as it hides `.fx` cards elsewhere) has run — a day with nothing left
    // for the chosen club collapses to the empty-state message instead of
    // showing a bare date heading. Shared between the day-tap handler and
    // `applyClubFilter` since either one can change what's visible.
    function updateDayDetailEmptyState() {
      var visibleDetail = null;
      dayDetails.forEach(function (detail) {
        var rows = detail.querySelectorAll('.day-row[data-clubs]');
        if (rows.length) {
          var anyRowVisible = detail.querySelector('.day-row[data-clubs]:not(.club-hidden)');
          detail.classList.toggle('club-hidden', !anyRowVisible);
        }
        if (!detail.hidden && !detail.classList.contains('club-hidden')) {
          visibleDetail = detail;
        }
      });
      if (!dayDetailEmpty) return visibleDetail;
      var daySelected = panel.querySelector('.cal-day.selected');
      if (!daySelected) {
        dayDetailEmpty.hidden = false;
        dayDetailEmpty.textContent = 'Tap a day above to see its games here.';
      } else if (visibleDetail) {
        dayDetailEmpty.hidden = true;
      } else {
        dayDetailEmpty.hidden = false;
        dayDetailEmpty.textContent = 'No games on this day.';
      }
      return visibleDetail;
    }

    calDays.forEach(function (dayBtn) {
      dayBtn.addEventListener('click', function () {
        var chosenDate = dayBtn.dataset.date;
        calDays.forEach(function (other) {
          var isSelected = other.dataset.date === chosenDate;
          other.classList.toggle('selected', isSelected);
          other.setAttribute('aria-pressed', String(isSelected));
        });
        dayDetails.forEach(function (detail) {
          detail.hidden = detail.dataset.date !== chosenDate;
        });
        var shownDetail = updateDayDetailEmptyState();
        // The calendar can span well over a year (cup rounds run into next
        // spring), so the shared detail block sits far below a day tapped in
        // an early month — scroll it into view rather than leaving the
        // reader to hunt for it themselves.
        (shownDetail || dayDetailEmpty).scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });

    setView(viewButtons[0].dataset.view);
    applyClubFilter();
  });

  // Rule-description tooltips: hover/focus works via CSS alone; this adds
  // tap-to-toggle for touch devices (no hover state), positions the
  // (position:fixed) tooltip against its icon so it can't be clipped by
  // an ancestor's overflow, and keeps it from overflowing the viewport
  // or drifting from its icon while the page scrolls.
  function positionTooltip(wrap) {
    var icon = wrap.querySelector('.info-icon');
    var tooltip = wrap.querySelector('.tooltip');
    if (!icon || !tooltip) return;
    var iconRect = icon.getBoundingClientRect();
    tooltip.style.left = iconRect.left + 'px';
    tooltip.style.top = (iconRect.bottom + 6) + 'px';
    var rect = tooltip.getBoundingClientRect();
    var rightOverflow = rect.right - (window.innerWidth - 8);
    var leftOverflow = 8 - rect.left;
    if (rightOverflow > 0) {
      tooltip.style.left = (iconRect.left - rightOverflow) + 'px';
    } else if (leftOverflow > 0) {
      tooltip.style.left = leftOverflow + 'px';
    }
  }
  function repositionVisibleTooltips() {
    document.querySelectorAll('.info-wrap:hover, .info-wrap:focus-within, .info-wrap.open').forEach(positionTooltip);
  }
  document.querySelectorAll('.info-wrap').forEach(function (wrap) {
    wrap.addEventListener('mouseenter', function () { positionTooltip(wrap); });
    wrap.addEventListener('focusin', function () { positionTooltip(wrap); });
  });
  document.querySelectorAll('.info-icon').forEach(function (icon) {
    icon.addEventListener('click', function (e) {
      e.stopPropagation();
      // Some icons now sit inside a <summary> (the collapsible "Biggest
      // upsides"/"Biggest problems" entries) — without this, a click here
      // would also trigger the browser's default toggle of the enclosing
      // <details>, expanding/collapsing it every time someone reads a rule's
      // description.
      e.preventDefault();
      var wrap = icon.closest('.info-wrap');
      var wasOpen = wrap.classList.contains('open');
      document.querySelectorAll('.info-wrap.open').forEach(function (w) {
        w.classList.remove('open');
      });
      if (!wasOpen) {
        wrap.classList.add('open');
        positionTooltip(wrap);
      }
    });
  });
  document.addEventListener('click', function () {
    document.querySelectorAll('.info-wrap.open').forEach(function (w) {
      w.classList.remove('open');
    });
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.info-wrap.open').forEach(function (w) {
        w.classList.remove('open');
      });
    }
  });
  // Capture phase so this also fires for scrolling inside .cal-wrap, whose
  // 'scroll' event doesn't bubble.
  window.addEventListener('scroll', repositionVisibleTooltips, true);
  window.addEventListener('resize', repositionVisibleTooltips);
</script>
</body>
</html>
